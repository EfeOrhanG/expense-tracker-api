@API_HostAddress = http://localhost:5077
@token = <JWT_TOKEN>

### Register a new user
POST {{API_HostAddress}}/api/auth/register
Content-Type: application/json

{
    "email": "roadmap@example.com",
    "username": "roadmap",
    "password": "password"
}

### Log in
POST {{API_HostAddress}}/api/auth/login
Content-Type: application/json

{
    "email": "roadmap@example.com",
    "password": "password"
}

### EXPENSES

GET {{API_HostAddress}}/api/expenses/list
Content-Type: application/json
Authorization: Bearer {{token}}

### CREATE EXPENSE

POST {{API_HostAddress}}/api/expenses
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "description": "Electronic Device",
    "amount": 2000,
    "category": "Electronics"
}


### GET EXPENSE BY ID

GET {{API_HostAddress}}/api/expenses/<EXPENSE_ID>
Content-Type: application/json
Authorization: Bearer {{token}}

### DELETE EXPENSE

DELETE  {{API_HostAddress}}/api/expenses/<EXPENSE_ID>
Content-Type: application/json
Authorization: Bearer {{token}}


### FILTER EXPENSE

GET {{API_HostAddress}}/api/expenses/period?period=last-week
Content-Type: application/json
Authorization: Bearer {{token}}


### UPDATE EXPENSE

PUT {{API_HostAddress}}/api/expenses/<EXPENSE_ID>
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "amount" : 300
}
